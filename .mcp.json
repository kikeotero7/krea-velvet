{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.84",
        "--headless",
        "--isolated",
        "--no-sandbox",
        "--executable-path",
        "${KREA_CHROME_PATH:-/opt/pw-browsers/chromium}"
      ]
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.12.0",
        "--headless",
        "--isolated",
        "--chrome-arg=--no-sandbox",
        "--executablePath",
        "${KREA_CHROME_PATH:-/opt/pw-browsers/chromium}"
      ]
    }
  }
}
